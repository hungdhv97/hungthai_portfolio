---
interface Props {
  number: string;
  title: string;
}

const { number, title } = Astro.props;
---

<div class="mb-10 flex items-center gap-4">
  <h2 class="font-sans text-2xl font-semibold text-lightest sm:text-3xl">
    <span class="font-mono text-teal">{number}.</span> {title}
  </h2>
  <div class="h-px w-full max-w-xs bg-slate/40"></div>
</div>
