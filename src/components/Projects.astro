---
import { projects } from '../data/content';
import SectionHeading from './SectionHeading.astro';
---

<section id="projects" class="py-24">
  <SectionHeading number="02" title="Projects" />

  <div class="space-y-6">
    {projects.featured.map((p) => (
      <article class="group relative rounded-lg border border-navy-lighter bg-navy-light/40 p-6 transition-transform hover:-translate-y-1 sm:p-8">
        <div class="flex flex-wrap items-center justify-between gap-3">
          <h3 class="font-sans text-xl font-semibold text-lightest">
            <a href={p.external} target="_blank" rel="noopener noreferrer" class="transition-colors group-hover:text-teal">
              {p.title}
            </a>
          </h3>
          <div class="flex gap-3 text-slate">
            <a href={p.github} target="_blank" rel="noopener noreferrer" aria-label={`${p.title} GitHub`} class="hover:text-teal">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0 0 24 12c0-6.63-5.37-12-12-12z" />
              </svg>
            </a>
            <a href={p.external} target="_blank" rel="noopener noreferrer" aria-label={`${p.title} external`} class="hover:text-teal">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                <path d="M14 3h7v7M10 14 21 3M21 14v5a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5" />
              </svg>
            </a>
          </div>
        </div>
        <p class="mt-3 leading-relaxed text-slate">{p.description}</p>
        <ul class="mt-4 flex flex-wrap gap-4 font-mono text-xs text-slate">
          {p.tech.map((t) => (
            <li>{t}</li>
          ))}
        </ul>
      </article>
    ))}
  </div>

  <h3 class="mt-16 mb-8 text-center font-mono text-lg text-lightest">Other Noteworthy Projects</h3>
  <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-2">
    {projects.grid.map((p) => (
      <article class="rounded-lg border border-navy-lighter bg-navy-light/40 p-6 transition-transform hover:-translate-y-1">
        <h4 class="font-sans text-base font-medium text-lightest">{p.title}</h4>
        <p class="mt-2 text-sm leading-relaxed text-slate">{p.description}</p>
        <ul class="mt-4 flex flex-wrap gap-3 font-mono text-xs text-teal">
          {p.tech.map((t) => (
            <li>{t}</li>
          ))}
        </ul>
      </article>
    ))}
  </div>
</section>
