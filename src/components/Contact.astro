---
import { site, skills } from '../data/content';
import SectionHeading from './SectionHeading.astro';
import SocialLinks from './SocialLinks.astro';
---

<section id="contact" class="py-24">
  <SectionHeading number="03" title="Contact" />

  <div class="grid gap-10 lg:grid-cols-[1fr_300px]">
    <div>
      <p class="max-w-xl leading-relaxed text-slate">
        I'm currently open to opportunities and interesting projects. If you'd like to get in touch, my inbox is always open — whether you have a question or just want to say hi.
      </p>
      <a href={`mailto:${site.email}`} class="mt-8 inline-block border border-teal px-6 py-3 font-mono text-sm text-teal transition-all hover:bg-teal/10 hover:-translate-y-0.5">
        Say Hello
      </a>
    </div>
    <div class="rounded border border-navy-lighter bg-navy-light/40 p-5">
      <h3 class="font-mono text-xs uppercase tracking-wide text-teal">Skills</h3>
      <div class="mt-3 space-y-3">
        <div>
          <p class="font-mono text-xs text-slate">Languages</p>
          <p class="mt-1 text-sm text-lightest">{skills.languages.join(', ')}</p>
        </div>
        <div>
          <p class="font-mono text-xs text-slate">Databases</p>
          <p class="mt-1 text-sm text-lightest">{skills.databases.join(', ')}</p>
        </div>
        <div>
          <p class="font-mono text-xs text-slate">Other</p>
          <p class="mt-1 text-sm text-lightest">{skills.other.join(', ')}</p>
        </div>
      </div>
    </div>
  </div>
</section>

<footer class="flex flex-col items-center gap-4 border-t border-navy-lighter py-10">
  <SocialLinks />
  <p class="font-mono text-xs text-slate">
    Designed & built by {site.name}. Hosted on Proxmox via Cloudflare Tunnel.
  </p>
  <p class="font-mono text-xs text-slate">&copy; {new Date().getFullYear()} {site.name}</p>
</footer>
